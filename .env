# Django Variables
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=localhost,[::1]

# Site Prefix
# No value needed if running locally
# On the FSDH it should resemble something like /app/<project name>/
DJANGO_BASE_URL=

# Django Superuser Creator (Creates a Django Superuser with the given credentials if no superuser exists.)
DJANGO_SUPERUSER_NAME=
DJANGO_SUPERUSER_PWORD=

# Database Info
DATABASE_NAME=postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_HOST=db
DATABASE_PORT=5432
